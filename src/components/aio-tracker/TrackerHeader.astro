---
const currentPath = Astro.url.pathname;

// A simple helper to check if the path matches to apply active styling
const isDashboard = currentPath === '/aio-tracker' || currentPath === '/aio-tracker/';
const isKeywords = currentPath.includes('/keywords');
---
<header class="h-[70px] shrink-0 bg-white dark:bg-[#1C1D21] border-b border-gray-200 dark:border-gray-800 px-4 sm:px-6 flex items-center justify-between z-40 relative">
  
  <!-- Left: Brand & Social Hook -->
<div class="flex items-center gap-3">
  <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
    <div class="w-7 h-7 bg-blue-600 text-white rounded flex items-center justify-center text-xs font-bold tracking-tighter">SU</div>
  </a>
  <span class="text-sm font-medium tracking-tight text-gray-900 dark:text-white hidden sm:block">AIO Tracker</span>
  
  <!-- LinkedIn Link -->
  <div class="h-4 w-[1px] bg-gray-300 dark:bg-gray-700 mx-1 hidden md:block"></div>
  <a 
    href="https://www.linkedin.com/in/samarthupadhyay/" 
    target="_blank" 
    rel="noopener noreferrer" 
    class="hidden md:inline-block text-xs font-medium text-gray-500 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400 transition-colors"
  >
    Follow me on LinkedIn
  </a>
</div>

  <!-- Middle: Navigation -->
  <nav class="flex items-center gap-6 absolute left-1/2 transform -translate-x-1/2">
    <a 
      href="/aio-tracker" 
      class={`text-sm font-medium transition-colors ${isDashboard ? 'text-blue-600 dark:text-blue-400' : 'text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white'}`}
    >
      Dashboard
    </a>
    <a 
      href="/aio-tracker/keywords" 
      class={`text-sm font-medium transition-colors ${isKeywords ? 'text-blue-600 dark:text-blue-400' : 'text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white'}`}
    >
      Keywords
    </a>
  </nav>

  <!-- Right: Auth & Controls -->
  <div class="flex items-center gap-4">
    <div id="auth-status-badge" class="hidden sm:flex items-center gap-1.5 text-xs font-medium text-gray-500">
      <div class="w-2 h-2 rounded-full bg-gray-300 dark:bg-gray-600"></div> Disconnected
    </div>
    <button id="btn-logout" class="hidden px-3 py-1.5 text-xs font-medium text-gray-600 dark:text-gray-300 border border-gray-200 dark:border-gray-700 rounded hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
      Sign out
    </button>
  </div>
</header>