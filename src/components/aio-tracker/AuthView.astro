---
---
<main id="view-auth" class="flex-1 overflow-y-auto flex items-center justify-center p-4">
  <div class="w-full max-w-[400px] bg-white dark:bg-[#1c1d21] border border-gray-200 dark:border-gray-800 rounded-lg p-6 sm:p-8 shadow-sm">
    
    <div class="flex border-b border-gray-200 dark:border-gray-800 mb-6">
      <button id="btn-tab-login" class="flex-1 pb-3 text-sm font-medium border-b-2 border-blue-600 text-blue-600 dark:text-blue-400 transition-all">Sign In</button>
      <button id="btn-tab-register" class="flex-1 pb-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-900 dark:hover:text-gray-200 transition-all">Create Node</button>
    </div>

    <div id="form-login-container" class="flex flex-col gap-4">
      <h2 class="text-lg font-medium text-gray-900 dark:text-white">Access Property</h2>
      <form id="login-form" class="flex flex-col gap-4">
        <div class="flex flex-col gap-1">
          <label class="text-xs text-gray-500">Node Identifier</label>
          <input type="text" id="login-pin" placeholder="e.g. aB123!" class="w-full px-3 py-2 bg-white dark:bg-[#131418] border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 font-mono tracking-widest text-sm text-gray-900 dark:text-white" required maxlength="10" />
        </div>
        <button type="submit" class="w-full py-2.5 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors mt-2">Next</button>
      </form>
    </div>

    <div id="form-register-container" class="hidden flex flex-col gap-4">
      <div id="register-ui">
        <h2 class="text-lg font-medium mb-1 text-gray-900 dark:text-white">Generate Identifier</h2>
        <p class="text-xs text-gray-500 mb-4">A unique PIN is required to sync telemetry.</p>
        <form id="register-form" class="flex flex-col gap-4">
          <div class="flex flex-col gap-1">
            <label class="text-xs text-gray-500">Recovery Email (Optional)</label>
            <input type="email" id="register-email" class="w-full px-3 py-2 bg-white dark:bg-[#131418] border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 text-sm text-gray-900 dark:text-white" />
          </div>
          <button type="submit" class="w-full py-2.5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 text-sm font-medium rounded-md hover:opacity-90 transition-opacity mt-2">Create New Node</button>
        </form>
      </div>

      <div id="pin-panel" class="hidden flex-col items-center text-center p-6 bg-[#F8F9FA] dark:bg-[#131418] rounded-md border border-gray-200 dark:border-gray-800">
        <p class="text-xs text-gray-600 dark:text-gray-400 mb-2">Save this securely to access your data</p>
        <span id="generated-pin" class="text-3xl font-medium tracking-widest text-gray-900 dark:text-white font-mono select-all mb-4"></span>
        <button id="btn-acknowledge-pin" class="w-full py-2 bg-white dark:bg-[#1c1d21] border border-gray-300 dark:border-gray-700 text-gray-900 dark:text-white text-sm font-medium rounded-md hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
          Continue to Workspace
        </button>
      </div>
    </div>
  </div>
</main>