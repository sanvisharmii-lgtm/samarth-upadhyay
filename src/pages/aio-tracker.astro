---
import Layout from '~/layouts/Layout.astro';
import TrackerHeader from '~/components/aio-tracker/TrackerHeader.astro';
import AuthView from '~/components/aio-tracker/AuthView.astro';
import WorkspaceView from '~/components/aio-tracker/WorkspaceView.astro';
import ConfigModal from '~/components/aio-tracker/ConfigModal.astro';

const metadata = {
  title: 'AIO Tracker | Analytics',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <ConfigModal />
  
  <div class="flex flex-col h-screen bg-[#F8F9FA] dark:bg-[#131418] font-sans text-gray-900 dark:text-gray-100 overflow-hidden">
    <TrackerHeader />
    <div class="flex-1 flex flex-col overflow-hidden">
      <AuthView />
      <WorkspaceView />
    </div>
  </div>
</Layout>

<script src="~/scripts/aio-tracker/app.ts"></script>