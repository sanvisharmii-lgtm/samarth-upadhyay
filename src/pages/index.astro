---
import Layout from '~/layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Samarth Upadhyay | Senior SEO Analyst',
  ignoreTitleTemplate: true,
};

const skills = [
  'Agentic Web', 
  'Technical SEO', 
  'PostgreSQL', 
  'SQLGlot', 
  'Python', 
  'Astro', 
  'Schema Markup', 
  'LLM Pipelines', 
  'Voice Synthesis'
];
---

<Layout metadata={metadata}>
  <main class="min-h-screen flex items-center justify-center bg-white dark:bg-slate-900 p-4 sm:p-8 font-sans text-gray-900 dark:text-gray-100">
    <div class="max-w-6xl w-full grid grid-cols-1 md:grid-cols-12 gap-4 sm:gap-6 auto-rows-fr">
      
      <!-- Profile & Description Panel (Spans 8 columns) -->
      <div class="md:col-span-8 bg-gray-50 dark:bg-slate-800 rounded-3xl p-8 sm:p-12 border border-gray-200 dark:border-slate-700 flex flex-col justify-center">
        <div class="flex flex-col sm:flex-row sm:items-center gap-6 mb-8">
          <!-- Premium SVG Monogram Profile Picture -->
          <div class="w-24 h-24 shrink-0 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-900 flex items-center justify-center text-3xl font-bold tracking-tighter select-none">
            SU
          </div>
          <div>
            <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tighter mb-2">Samarth Upadhyay</h1>
            <p class="text-xl text-gray-700 dark:text-slate-300 font-medium tracking-tight">Senior SEO Analyst @ Great Learning</p>
            <p class="text-sm text-gray-500 dark:text-slate-400 mt-2 flex items-center gap-1">
              <Icon name="tabler:map-pin" class="w-4 h-4" /> Bengaluru, India
            </p>
          </div>
        </div>
        <p class="text-lg text-gray-600 dark:text-slate-400 max-w-2xl leading-relaxed">
          Specializing in Agentic Web optimization, programmatic SEO, and high-performance technical architecture. Proven track record in orchestrating scalable, AI-driven content pipelines and deploying robust web protocols for optimal machine readability.
        </p>
      </div>

      <!-- Connect Panel (Spans 4 columns) -->
      <div class="md:col-span-4 bg-gray-900 dark:bg-gray-100 rounded-3xl p-8 border border-gray-800 dark:border-gray-200 text-white dark:text-gray-900 flex flex-col justify-between transition-transform hover:scale-[1.02]">
        <div>
          <Icon name="tabler:network" class="w-8 h-8 mb-4 opacity-80" />
          <h2 class="text-2xl font-bold tracking-tight mb-2">Connect</h2>
          <p class="opacity-80 text-sm mb-6">Open for discussions regarding technical SEO, web performance, and AI integration.</p>
        </div>
        <div class="flex gap-4">
          <a href="https://github.com/samarth-upadhyay" target="_blank" rel="noopener noreferrer" class="hover:opacity-75 transition-opacity" aria-label="GitHub">
            <Icon name="tabler:brand-github" class="w-8 h-8" />
          </a>
          <a href="#" target="_blank" rel="noopener noreferrer" class="hover:opacity-75 transition-opacity" aria-label="LinkedIn">
            <Icon name="tabler:brand-linkedin" class="w-8 h-8" />
          </a>
        </div>
      </div>

      <!-- Skills Panel (Spans 6 columns) -->
      <div class="md:col-span-6 bg-gray-50 dark:bg-slate-800 rounded-3xl p-8 border border-gray-200 dark:border-slate-700 transition-transform hover:scale-[1.01]">
        <div class="flex items-center gap-3 mb-6">
          <Icon name="tabler:cpu" class="w-6 h-6 text-gray-800 dark:text-gray-200" />
          <h2 class="text-xl font-bold tracking-tight">Technical Infrastructure</h2>
        </div>
        <div class="flex flex-wrap gap-2">
          {skills.map((skill) => (
            <span class="px-4 py-2 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-600 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300">
              {skill}
            </span>
          ))}
        </div>
      </div>

      <!-- Knowledge Panel (Spans 6 columns) -->
      <div class="md:col-span-6 bg-gray-50 dark:bg-slate-800 rounded-3xl p-8 border border-gray-200 dark:border-slate-700 transition-transform hover:scale-[1.01]">
        <div class="flex items-center gap-3 mb-6">
          <Icon name="tabler:database" class="w-6 h-6 text-gray-800 dark:text-gray-200" />
          <h2 class="text-xl font-bold tracking-tight">Knowledge Panel</h2>
        </div>
        <ul class="space-y-5 text-sm text-gray-600 dark:text-slate-400">
          <li class="flex flex-col">
            <span class="font-bold text-base text-gray-900 dark:text-gray-100 mb-1">Professional History</span>
            <span>Great Learning &middot; AppsforBharat &middot; Y-Axis Overseas Careers</span>
          </li>
          <li class="flex flex-col">
            <span class="font-bold text-base text-gray-900 dark:text-gray-100 mb-1">Education</span>
            <span>Bachelor of Arts, BHOJ Open University (PCM focus)</span>
          </li>
          <li class="flex flex-col">
            <span class="font-bold text-base text-gray-900 dark:text-gray-100 mb-1">Hardware Environment</span>
            <span>Optimized for local AI execution on Apple Silicon (M5 architecture)</span>
          </li>
        </ul>
      </div>

    </div>
  </main>
</Layout>