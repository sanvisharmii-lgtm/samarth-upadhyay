---
import Layout from '~/layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Samarth Upadhyay | SEO ',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <main class="min-h-screen flex items-center justify-center bg-white dark:bg-[#131418] p-4 sm:p-6 lg:p-8 font-sans text-gray-900 dark:text-gray-100">
    <div class="max-w-5xl w-full grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">

      <!-- Profile & Description Panel -->
      <div class="md:col-span-2 bg-gray-50 dark:bg-[#1c1d21] rounded-2xl sm:rounded-3xl p-6 sm:p-10 border border-gray-200 dark:border-gray-800 flex flex-col justify-center">
        <div class="flex flex-col sm:flex-row sm:items-center gap-5 sm:gap-6 mb-6 sm:mb-8">
          <!-- Premium Monogram -->
          <div>
            <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-1.5">Samarth Upadhyay</h1>
            <p class="text-lg text-gray-700 dark:text-gray-300 font-medium tracking-tight">SEO</p>
            <p class="text-base text-gray-500 dark:text-gray-400 mt-1.5 flex items-center gap-1.5">
              <Icon name="tabler:map-pin" class="w-4 h-4" /> Bengaluru, India
            </p>
          </div>
        </div>
        <p class="text-base sm:text-lg text-gray-600 dark:text-gray-400 max-w-2xl leading-relaxed">
        Hi, I'm an SEO expert focused on turning search traffic into business growth.
        </p>
      </div>

      <!-- Right Column: Stacked Panels -->
      <div class="md:col-span-1 flex flex-col gap-4 sm:gap-6">

        <!-- AIO Tracker Tool Link -->
        <a href="/aio-tracker" class="flex-1 bg-blue-50/50 dark:bg-blue-900/10 rounded-2xl sm:rounded-3xl p-6 sm:p-8 border border-blue-100 dark:border-blue-800/30 flex flex-col justify-between transition-all hover:bg-blue-50 dark:hover:bg-blue-900/20 group">
          <div>
            <div class="w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center mb-4">
              <Icon name="tabler:radar" class="w-5 h-5 group-hover:animate-pulse" />
            </div>
            <h2 class="text-xl font-bold tracking-tight mb-2 text-blue-900 dark:text-blue-100">AIO Tracker</h2>
            <p class="text-base text-blue-800/80 dark:text-blue-200/70 leading-relaxed">
              AI Overview monitoring Tool.
            </p>
          </div>
          <div class="mt-6 flex items-center gap-2 font-semibold text-sm uppercase tracking-wider text-blue-700 dark:text-blue-300">
            Launch Tool <Icon name="tabler:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </div>
        </a>

        <!-- Connect Panel -->
        <div class="flex-1 bg-gray-50 dark:bg-[#1c1d21] rounded-2xl sm:rounded-3xl p-6 sm:p-8 border border-gray-200 dark:border-gray-800 flex flex-col justify-between">
          <div>
            <h2 class="text-xl font-bold tracking-tight mb-2">Connect</h2>
            <p class="text-base text-gray-600 dark:text-gray-400 leading-relaxed mb-6">
              Always interested in meaningful conversations around search, performance, and intelligent automation.
            </p>
          </div>
          <div class="flex gap-4">

            <a href="https://www.linkedin.com/in/samarthupadhyay/" target="_blank" rel="noopener noreferrer" class="p-2 text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400 transition-colors" aria-label="LinkedIn">
              <Icon name="tabler:brand-linkedin" class="w-7 h-7" />
            </a>
          </div>
        </div>

      </div>

    </div>
  </main>
</Layout>